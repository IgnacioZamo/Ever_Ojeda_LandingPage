---
/**
 * SECCIÓN: SOBRE MÍ + CÓMO TRABAJO (#proceso)
 * ------------------------------------------------------------------
 * Parte 1 · Sobre mí: retrato (por ahora un monograma), presentación
 *   y credenciales. Para usar una foto real, reemplazar el contenido de
 *   `.portrait` por <img src="/ever.jpg" alt="Ever Ojeda" /> y guardar
 *   la foto en /public.
 * Parte 2 · Cómo trabajo: los 4 pasos del servicio para una empresa
 *   nueva. La numeración (01–04) indica un orden real.
 *
 * Fondo: banda turquesa (.band), unida al resto con olas animadas (Wave.astro).
 * Layout pasos: 4 columnas → 2 (tablet ≤ 1024px) → 1 (móvil ≤ 600px).
 */
import { site } from '../data/site';

const steps = [
  { title: 'Visita inicial', text: 'Recorro la planta u obra con el responsable de la empresa y reviso la documentación existente.', time: 'Semana 1' },
  { title: 'Diagnóstico', text: 'Entrego un informe con los riesgos detectados y los incumplimientos, ordenados por gravedad y urgencia.', time: 'Semana 2' },
  { title: 'Plan de acción', text: 'Acordamos medidas, responsables, plazos e inversión, adaptados a la operación de tu empresa.', time: 'Semana 3' },
  { title: 'Seguimiento', text: 'Visitas periódicas, mediciones, capacitaciones e informe mensual para la dirección.', time: 'Mensual' },
];

// EJEMPLO: completar con títulos, matrícula y cursos reales.
const credentials = [
  site.title,
  'Matrícula profesional N.º 0000 (ejemplo)',
  'Técnico en Seguridad e Higiene',
  'Formación en ergonomía y protección contra incendios',
];
---

<section class="section band" id="proceso" aria-labelledby="proceso-title">
  <div class="wrap">
    <!-- Parte 1: Sobre mí -->
    <div class="about">
      <div class="portrait" aria-hidden="true">
        <span>{site.initials}</span>
      </div>
      <div class="about-text">
        <p class="eyebrow">Sobre mí</p>
        <h2 id="proceso-title">Un profesional que se pone el casco y recorre la planta</h2>
        <p>
          Hace más de doce años que acompaño a empresas a convertir la normativa en hábitos concretos. Trabajo en el lugar, hablo con
          quienes hacen la tarea y le entrego a la dirección información clara para decidir dónde invertir en prevención.
        </p>
        <ul class="creds">
          {credentials.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>

    <!-- Parte 2: Cómo trabajo -->
    <h3 class="steps-title">Cómo empiezo a trabajar con tu empresa</h3>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="time">{s.time}</span>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* ---------- Sobre mí ---------- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    margin-bottom: clamp(48px, 7vw, 88px);
  }
  .portrait {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    overflow: hidden;
    border-radius: 28px;
    background:
      radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--surface) 55%, transparent), transparent 55%),
      linear-gradient(160deg, var(--tint-2), var(--accent));
    box-shadow: var(--shadow);
  }
  /* Ola suave en la base del retrato */
  .portrait::after {
    content: '';
    position: absolute;
    inset: auto -10% -18% -10%;
    height: 45%;
    background: var(--surface);
    opacity: 0.25;
    border-radius: 50% 50% 0 0 / 30% 30% 0 0;
  }
  .portrait span {
    font: 800 clamp(4rem, 12vw, 8rem)/1 var(--font-display);
    font-stretch: 125%;
    color: var(--surface);
    opacity: 0.9;
  }
  .about-text {
    display: grid;
    gap: 18px;
    min-width: 0;
  }
  .about-text h2 {
    font-size: var(--step-3);
    font-weight: 750;
    font-stretch: 108%;
  }
  .about-text > p {
    color: var(--muted);
    max-width: 60ch;
  }
  .creds {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .creds li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-weight: 500;
  }
  /* Rombo turquesa como viñeta */
  .creds li::before {
    content: '';
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--accent);
    transform: rotate(45deg) translateY(-1px);
  }

  /* ---------- Pasos ---------- */
  .steps-title {
    font-size: var(--step-2);
    font-weight: 750;
    margin-bottom: 28px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .steps li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 0;
    padding-top: 26px;
    border-top: 2px solid var(--tint-2);
  }
  /* Punto sobre la línea de tiempo */
  .steps li::before {
    content: '';
    position: absolute;
    top: -7px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent-strong);
    box-shadow: 0 0 0 4px var(--tint);
  }
  .num {
    font: 800 2.6rem/1 var(--font-display);
    font-stretch: 120%;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .steps h4 {
    margin: 4px 0 0;
    font: 700 1.2rem/1.2 var(--font-display);
  }
  .steps p {
    color: var(--muted);
    font-size: 0.98rem;
  }

  /* ---------- Tablet (≤ 1024px) ---------- */
  @media (max-width: 1024px) {
    .about {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 36px;
    }
  }

  /* ---------- Móvil (≤ 600px) ---------- */
  @media (max-width: 600px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .portrait {
      width: 160px;
      aspect-ratio: 1;
      border-radius: 50%;
    }
    .portrait span {
      font-size: 3.4rem;
    }
    .steps {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 28px;
    }
  }
</style>
