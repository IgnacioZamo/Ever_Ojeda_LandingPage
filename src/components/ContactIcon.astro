---
/**
 * COMPONENTE: ÍCONO DE CANAL DE CONTACTO
 * ------------------------------------------------------------------
 * Ícono circular reutilizable (Contacto y Footer).
 * Uso: <ContactIcon name="whatsapp" />   (whatsapp | linkedin | email | pin)
 * Prop `tone`: "light" (por defecto, sobre fondos claros) o "dark" (footer).
 * Los íconos usan currentColor, así heredan el color del tema.
 */
interface Props {
  name: 'whatsapp' | 'linkedin' | 'email' | 'pin';
  tone?: 'light' | 'dark';
}

const { name, tone = 'light' } = Astro.props;

const paths: Record<Props['name'], string> = {
  // Glifos simplificados (no son los logos oficiales de cada marca)
  whatsapp:
    '<path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 8.5c.3-.6.6-.6.9-.6h.5c.2 0 .4 0 .5.4l.7 1.7c.1.2 0 .4-.1.6l-.5.6c-.1.1-.2.3 0 .5.5.9 1.3 1.7 2.3 2.2.2.1.4.1.5-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.4.2.4.4 0 .5-.2 1.1-.6 1.4-.5.4-1.2.6-1.9.4-1.6-.5-3-1.4-4.1-2.6-.8-.9-1.4-1.9-1.6-3-.1-.7.1-1.3.3-1.8z" fill="currentColor"/>',
  linkedin:
    '<rect x="3" y="3" width="18" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M7.5 10v6.5M7.5 7.4v.1M11 16.5V10m0 3.2c0-1.8 1-3.2 2.6-3.2 1.5 0 2.4 1 2.4 3v3.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>',
  email:
    '<rect x="3" y="5" width="18" height="14" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/>',
};
---

<span class:list={['contact-icon', tone]} aria-hidden="true">
  <svg width="22" height="22" viewBox="0 0 24 24" set:html={paths[name]} />
</span>

<style>
  .contact-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .light {
    background: var(--surface);
    border: 1px solid var(--tint-2);
    color: var(--accent-strong);
  }
  .dark {
    background: color-mix(in srgb, var(--footer-fg) 10%, transparent);
    color: var(--accent);
  }
</style>
